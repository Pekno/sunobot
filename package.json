{
  "name": "suno-bot",
  "version": "1.0.2",
  "description": "Discord bot to read suno musics",
  "main": "./dist/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/main/main.ts",
    "start": "node dist/main/main.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').cpSync('src/locales','dist/locales',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "author": "Pekn0",
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@pekno/simple-discordbot": "^0.0.5",
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.5",
    "i18n": "^0.15.4",
    "libsodium-wrappers": "^0.8.4",
    "user-agents": "^2.1.201"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/i18n": "^0.13.12",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
